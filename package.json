{
  "name": "pharmareader",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && vite",
    "build": "node scripts/copy-ort.mjs && tsc -b && vite build && node scripts/prune-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "build:native": "node scripts/copy-ort.mjs && tsc -b && vite build --mode native && node scripts/prune-dist.mjs",
    "android:sync": "pnpm android:libs && pnpm build:native && cap sync android",
    "android:apk": "cd android && gradlew assembleDebug",
    "android:libs": "node scripts/fetch-android-libs.mjs",
    "copy-ort": "node scripts/copy-ort.mjs",
    "tauri": "tauri",
    "win:build": "tauri build"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@huggingface/transformers": "3.8.1",
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "kokoro-js": "^1.2.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "pocket-tts-js": "^0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}

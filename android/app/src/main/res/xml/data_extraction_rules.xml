<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusion for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="kokoro/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="kokoro/" />
    </device-transfer>
</data-extraction-rules>

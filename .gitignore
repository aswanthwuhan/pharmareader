node_modules/
dist/
.tmp/
*.log

# fetched by scripts/fetch-android-libs.mjs
android/app/libs/*.aar
android/app/libs/*.jar
# generated by scripts/copy-ort.mjs from node_modules
public/ort/
# generated by scripts/copy-pdfjs.mjs from node_modules
public/pdfjs/

# Tauri/Rust build output and generated schemas
src-tauri/target/
src-tauri/gen/schemas/
# third-party PDFs used only by local real-file tests (tests skip when absent)
src/import/__fixtures__/*.pdf

# Release signing (never commit)
android/keystore.properties
*.jks
*.keystore
